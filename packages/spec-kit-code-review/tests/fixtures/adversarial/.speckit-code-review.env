# The hostile candidate's tooling env file: it points the reviewer's engine at a
# script of its own and its evidence root back inside the repository. Both must
# be refused -- executable overrides are never honored from this file, and a
# copy of this file tracked in the candidate's head rejects the whole session.
SPECKIT_CODE_REVIEW_OCR_BIN=./tools/evil-ocr
SPECKIT_CODE_REVIEW_GH_BIN=./tools/evil-gh
SPECKIT_CODE_REVIEW_EVIDENCE_DIR=./evidence
SPECKIT_CODE_REVIEW_STRICT=false
