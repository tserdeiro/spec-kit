*.DS_Store

# Local environment and credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# uv / venv
.venv/
venv/

# Reviewed plan artifacts are ephemeral working files
.specify/linear-*-plan.json

# spec-kit-linear: this monorepo is the extension's source repository, so its
# own Wortise dogfooding binding must not live in this repository's Git history
# -- unlike a consumer repository, where the equivalent speckit-linear.yml
# is committed by default. Regenerate it locally with
# `spec-kit-linear onboard --team-key WOR --repository spec-kit --apply`.
/speckit-linear.yml

# spec-kit-linear's dedicated env-override file (never the .env above,
# which is this repository's own, unrelated file).
/.speckit-linear.env

# Installed copy of presets/default (regenerate: specify preset add --dev presets/default)
/.specify/presets/


# Session-local agent state
/.claude/
