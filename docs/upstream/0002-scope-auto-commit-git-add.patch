 extensions/git/scripts/bash/auto-commit.sh    |  60 +++-
 .../git/scripts/powershell/auto-commit.ps1    |  78 ++++-
 extensions/git/scripts/python/auto_commit.py  | 116 ++++++-
 tests/extensions/git/test_git_extension.py    | 298 +++++++++++++++---
 .../git/test_git_extension_python_parity.py   |  59 +++-
 5 files changed, 548 insertions(+), 63 deletions(-)

diff --git a/extensions/git/scripts/bash/auto-commit.sh b/extensions/git/scripts/bash/auto-commit.sh
index 17fec66..4701568 100755
--- a/extensions/git/scripts/bash/auto-commit.sh
+++ b/extensions/git/scripts/bash/auto-commit.sh
@@ -72,6 +72,24 @@ _find_project_root() {
 REPO_ROOT=$(_find_project_root "$SCRIPT_DIR") || REPO_ROOT="$(pwd)"
 cd "$REPO_ROOT"
 
+# Source common.sh for get_feature_paths, so the scoped `git add` below can
+# resolve the active feature's directory. Search locations in priority
+# order, mirroring create-new-feature-branch.sh:
+#  1. .specify/scripts/bash/common.sh (installed project)
+#  2. scripts/bash/common.sh (source checkout fallback)
+# Its absence just means the tracked-only fallback below applies -- never a
+# hard error, the same tolerance this script already gives a missing config
+# file or a non-git directory.
+for _common_candidate in \
+    "$REPO_ROOT/.specify/scripts/bash/common.sh" \
+    "$REPO_ROOT/scripts/bash/common.sh"
+do
+    if [ -f "$_common_candidate" ]; then
+        source "$_common_candidate"
+        break
+    fi
+done
+
 # Check if git is available
 if ! command -v git >/dev/null 2>&1; then
     echo "[specify] Warning: Git not found; skipped auto-commit" >&2
@@ -204,8 +222,46 @@ if [ -z "$_commit_msg" ]; then
     _commit_msg="[Spec Kit] Auto-commit ${_phase} ${_command_name}"
 fi
 
-# Stage and commit
-_git_out=$(git add . 2>&1) || { echo "[specify] Error: git add failed: $_git_out" >&2; exit 1; }
+# Stage only what this event's command produced -- never a blanket `git add`
+# for every event, which sweeps in every untracked file in the tree
+# regardless of which command ran.
+#
+# Scope, by event:
+#   after_constitution    -> .specify/memory/, the constitution's own
+#                            directory
+#   before_implement,
+#   after_implement       -> the whole working tree (git add -A), same as
+#                            before this scoping existed: implementation
+#                            code lands wherever the project puts it (src/,
+#                            lib/, ...), never only inside the feature
+#                            directory, so these two events cannot be
+#                            scoped to it
+#   every other event     -> the active feature's directory, resolved the
+#                            same way every other script resolves it
+#                            (get_feature_paths: SPECIFY_FEATURE_DIRECTORY,
+#                            else .specify/feature.json)
+#   unresolvable feature  -> tracked files only (git add -u), so an
+#                            in-progress edit still commits without ever
+#                            adding an untracked file outside a known scope
+if [ "$EVENT_NAME" = "after_constitution" ]; then
+    _git_out=$(git add -- "$REPO_ROOT/.specify/memory" 2>&1) || { echo "[specify] Error: git add failed: $_git_out" >&2; exit 1; }
+elif [ "$EVENT_NAME" = "before_implement" ] || [ "$EVENT_NAME" = "after_implement" ]; then
+    _git_out=$(git add -A 2>&1) || { echo "[specify] Error: git add failed: $_git_out" >&2; exit 1; }
+elif type get_feature_paths >/dev/null 2>&1 && _paths_output=$(get_feature_paths --no-persist 2>/dev/null); then
+    eval "$_paths_output"
+    _git_out=$(git add -- "$FEATURE_DIR" 2>&1) || { echo "[specify] Error: git add failed: $_git_out" >&2; exit 1; }
+else
+    _git_out=$(git add -u 2>&1) || { echo "[specify] Error: git add failed: $_git_out" >&2; exit 1; }
+fi
+
+# The event's own scope may hold nothing even though something elsewhere in
+# the tree is dirty (the pre-check above looks at the whole repo); skip
+# cleanly rather than trying to commit an empty index.
+if git diff --cached --quiet 2>/dev/null; then
+    echo "[specify] No changes to commit after $EVENT_NAME" >&2
+    exit 0
+fi
+
 _git_out=$(git commit -q -m "$_commit_msg" 2>&1) || { echo "[specify] Error: git commit failed: $_git_out" >&2; exit 1; }
 
 echo "[OK] Changes committed ${_phase} ${_command_name}" >&2
diff --git a/extensions/git/scripts/powershell/auto-commit.ps1 b/extensions/git/scripts/powershell/auto-commit.ps1
index d27b484..1c2fa37 100644
--- a/extensions/git/scripts/powershell/auto-commit.ps1
+++ b/extensions/git/scripts/powershell/auto-commit.ps1
@@ -63,6 +63,24 @@ $repoRoot = Find-ProjectRoot -StartDir $PSScriptRoot
 if (-not $repoRoot) { $repoRoot = Get-Location }
 Set-Location $repoRoot
 
+# Source common.ps1 for Get-FeaturePathsEnv, so the scoped `git add` below can
+# resolve the active feature's directory. Search locations in priority
+# order, mirroring create-new-feature-branch.ps1:
+#  1. .specify/scripts/powershell/common.ps1 (installed project)
+#  2. scripts/powershell/common.ps1 (source checkout fallback)
+# Its absence just means the tracked-only fallback below applies -- never a
+# hard error, the same tolerance this script already gives a missing config
+# file or a non-git directory.
+foreach ($_commonCandidate in @(
+    (Join-Path $repoRoot ".specify/scripts/powershell/common.ps1"),
+    (Join-Path $repoRoot "scripts/powershell/common.ps1")
+)) {
+    if (Test-Path $_commonCandidate) {
+        . $_commonCandidate
+        break
+    }
+}
+
 # Check if git is available
 if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
     Write-Warning "[specify] Warning: Git not found; skipped auto-commit"
@@ -210,14 +228,70 @@ if (-not $commitMsg) {
     $commitMsg = "[Spec Kit] Auto-commit $phase $commandName"
 }
 
-# Stage and commit
+# Stage only what this event's command produced -- never a blanket `git add`
+# for every event, which sweeps in every untracked file in the tree
+# regardless of which command ran.
+#
+# Scope, by event:
+#   after_constitution    -> .specify/memory/, the constitution's own
+#                            directory
+#   before_implement,
+#   after_implement       -> the whole working tree (git add -A), same as
+#                            before this scoping existed: implementation
+#                            code lands wherever the project puts it (src/,
+#                            lib/, ...), never only inside the feature
+#                            directory, so these two events cannot be
+#                            scoped to it
+#   every other event     -> the active feature's directory, resolved the
+#                            same way every other script resolves it
+#                            (Get-FeaturePathsEnv: SPECIFY_FEATURE_DIRECTORY,
+#                            else .specify/feature.json)
+#   unresolvable feature  -> tracked files only (git add -u), so an
+#                            in-progress edit still commits without ever
+#                            adding an untracked file outside a known scope
+#
 # Relax ErrorActionPreference so CRLF warnings on stderr do not terminate,
 # while still allowing redirected error output to be captured for diagnostics.
 $savedEAP = $ErrorActionPreference
 $ErrorActionPreference = 'Continue'
 try {
-    $out = git add . 2>&1 | Out-String
+    if ($EventName -eq 'after_constitution') {
+        $out = git add -- (Join-Path $repoRoot '.specify/memory') 2>&1 | Out-String
+    } elseif ($EventName -eq 'before_implement' -or $EventName -eq 'after_implement') {
+        $out = git add -A 2>&1 | Out-String
+    } elseif ((Get-Command Get-FeaturePathsEnv -ErrorAction SilentlyContinue) -and
+              ($featurePaths = Get-FeaturePathsEnv -NoPersist -ReturnNullOnError)) {
+        $out = git add -- $featurePaths.FEATURE_DIR 2>&1 | Out-String
+    } else {
+        $out = git add -u 2>&1 | Out-String
+    }
     if ($LASTEXITCODE -ne 0) { throw "git add failed: $out" }
+} catch {
+    Write-Warning "[specify] Error: $_"
+    exit 1
+} finally {
+    $ErrorActionPreference = $savedEAP
+}
+
+# The event's own scope may hold nothing even though something elsewhere in
+# the tree is dirty (the pre-check above looks at the whole repo); skip
+# cleanly rather than trying to commit an empty index.
+$savedEAP = $ErrorActionPreference
+$ErrorActionPreference = 'Continue'
+try {
+    git diff --cached --quiet 2>$null
+    $nothingStaged = ($LASTEXITCODE -eq 0)
+} finally {
+    $ErrorActionPreference = $savedEAP
+}
+if ($nothingStaged) {
+    Write-Host "[specify] No changes to commit after $EventName" -ForegroundColor DarkGray
+    exit 0
+}
+
+$savedEAP = $ErrorActionPreference
+$ErrorActionPreference = 'Continue'
+try {
     $out = git commit -q -m $commitMsg 2>&1 | Out-String
     if ($LASTEXITCODE -ne 0) { throw "git commit failed: $out" }
 } catch {
diff --git a/extensions/git/scripts/python/auto_commit.py b/extensions/git/scripts/python/auto_commit.py
index c669289..2ef1df7 100644
--- a/extensions/git/scripts/python/auto_commit.py
+++ b/extensions/git/scripts/python/auto_commit.py
@@ -11,6 +11,9 @@ Usage: auto_commit.py <event_name>
 
 from __future__ import annotations
 
+import contextlib
+import importlib.util
+import io
 import re
 import shutil
 import subprocess
@@ -28,6 +31,90 @@ def _find_project_root(start: Path) -> Path | None:
         current = current.parent
 
 
+def _load_core_common(project_root: Path | None):
+    """Load the core common.py from the project's installed scripts.
+
+    Search locations in priority order, mirroring the bash/PowerShell twins:
+     1. .specify/scripts/python/common.py (installed project)
+     2. scripts/python/common.py (source checkout fallback)
+    Returns the loaded module, or None when neither is present.
+    """
+    if project_root is None:
+        return None
+    for relative in (".specify/scripts/python/common.py", "scripts/python/common.py"):
+        candidate = project_root / relative
+        if candidate.is_file():
+            spec = importlib.util.spec_from_file_location("speckit_core_common", candidate)
+            if spec is None or spec.loader is None:
+                continue
+            module = importlib.util.module_from_spec(spec)
+            sys.modules[spec.name] = module
+            spec.loader.exec_module(module)
+            return module
+    return None
+
+
+def _resolve_feature_dir(repo_root: Path, script_file: Path) -> Path | None:
+    """Best-effort: the active feature's directory, or None when it can't be
+    resolved (no core common.py, no SPECIFY_FEATURE_DIRECTORY, no readable
+    .specify/feature.json) -- never raises, so the caller can fall back to
+    staging tracked files only. Its own "not found" diagnostic is
+    intentionally suppressed here: an unresolvable feature is this
+    function's normal, silent fallback signal, not an error to report.
+    """
+    common = _load_core_common(repo_root)
+    if common is None:
+        return None
+    with contextlib.redirect_stderr(io.StringIO()):
+        try:
+            return common.get_feature_paths(no_persist=True, script_file=script_file).feature_dir
+        except SystemExit:
+            return None
+
+
+def _stage_event_scope(event_name: str, repo_root: Path, script_file: Path) -> str | None:
+    """Stage only what this event's command produced -- never a blanket
+    `git add` for every event, which sweeps in every untracked file in the
+    tree regardless of which command ran.
+
+    Scope, by event:
+      after_constitution    -> .specify/memory/, the constitution's own
+                               directory
+      before_implement,
+      after_implement       -> the whole working tree (git add -A), same as
+                               before this scoping existed: implementation
+                               code lands wherever the project puts it
+                               (src/, lib/, ...), never only inside the
+                               feature directory, so these two events
+                               cannot be scoped to it
+      every other event     -> the active feature's directory, resolved the
+                               same way every other script resolves it
+                               (get_feature_paths: SPECIFY_FEATURE_DIRECTORY,
+                               else .specify/feature.json)
+      unresolvable feature  -> tracked files only (git add -u), so an
+                               in-progress edit still commits without ever
+                               adding an untracked file outside a known
+                               scope
+
+    Returns None on success, or the combined stdout+stderr of a failed
+    ``git add`` on failure.
+    """
+    if event_name == "after_constitution":
+        add_args = ["add", "--", str(repo_root / ".specify" / "memory")]
+    elif event_name in ("before_implement", "after_implement"):
+        add_args = ["add", "-A"]
+    else:
+        feature_dir = _resolve_feature_dir(repo_root, script_file)
+        add_args = ["add", "--", str(feature_dir)] if feature_dir else ["add", "-u"]
+
+    result = subprocess.run(
+        ["git", *add_args], cwd=repo_root, capture_output=True, text=True
+    )
+    if result.returncode != 0:
+        return (result.stdout + result.stderr).strip()
+    return None
+
+
 def _value_after_colon(line: str) -> str:
     return re.sub(r"^[^:]*:\s*", "", line)
 
@@ -176,16 +263,25 @@ def main(argv: list[str]) -> int:
     if not commit_msg:
         commit_msg = f"[Spec Kit] Auto-commit {phase} {command_name}"
 
-    steps = [
-        (["git", "add", "."], "git add"),
-        (["git", "commit", "-q", "-m", commit_msg], "git commit"),
-    ]
-    for cmd, label in steps:
-        result = subprocess.run(cmd, cwd=repo_root, capture_output=True, text=True)
-        if result.returncode != 0:
-            output = (result.stdout + result.stderr).strip()
-            print(f"[specify] Error: {label} failed: {output}", file=sys.stderr)
-            return 1
+    add_error = _stage_event_scope(event_name, repo_root, Path(__file__).resolve())
+    if add_error is not None:
+        print(f"[specify] Error: git add failed: {add_error}", file=sys.stderr)
+        return 1
+
+    # The event's own scope may hold nothing even though something elsewhere
+    # in the tree is dirty (the pre-check above looks at the whole repo);
+    # skip cleanly rather than trying to commit an empty index.
+    if _quiet("diff", "--cached", "--quiet"):
+        print(f"[specify] No changes to commit after {event_name}", file=sys.stderr)
+        return 0
+
+    result = subprocess.run(
+        ["git", "commit", "-q", "-m", commit_msg], cwd=repo_root, capture_output=True, text=True
+    )
+    if result.returncode != 0:
+        output = (result.stdout + result.stderr).strip()
+        print(f"[specify] Error: git commit failed: {output}", file=sys.stderr)
+        return 1
 
     print(f"[OK] Changes committed {phase} {command_name}", file=sys.stderr)
     return 0
