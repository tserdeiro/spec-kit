+# ── Scoped staging tests (never `git add .`) ─────────────────────────────────
+
+
+@requires_bash
+class TestAutoCommitScopeBash:
+    """auto-commit.sh stages only what the event's command produced -- never
+    a blanket `git add .`, which would sweep in every untracked file in the
+    tree regardless of which command ran."""
+
+    def test_feature_scope_excludes_unrelated_untracked_file(self, tmp_path: Path):
+        """A resolvable feature directory is staged; an unrelated untracked
+        file elsewhere in the tree is not."""
+        project = _setup_project_with_feature(tmp_path)
+        _write_config(project, (
+            "auto_commit:\n"
+            "  default: false\n"
+            "  after_specify:\n"
+            "    enabled: true\n"
+        ))
+        (project / "specs" / "001-test" / "spec.md").write_text("in scope")
+        (project / "unrelated.txt").write_text("out of scope")
+
+        result = _run_bash("auto-commit.sh", project, "after_specify")
+        assert result.returncode == 0
+
+        show = subprocess.run(
+            ["git", "show", "--stat", "--oneline", "HEAD"],
+            cwd=project, capture_output=True, text=True,
+        )
+        assert "spec.md" in show.stdout
+        assert "unrelated.txt" not in show.stdout
+        status = subprocess.run(
+            ["git", "status", "--porcelain", "--", "unrelated.txt"],
+            cwd=project, capture_output=True, text=True,
+        )
+        assert status.stdout.strip() == "?? unrelated.txt"
+
+    def test_constitution_scope_stages_only_memory_dir(self, tmp_path: Path):
+        """after_constitution stages .specify/memory/ only, never the rest
+        of the tree."""
+        project = _setup_project(tmp_path)
+        _write_config(project, (
+            "auto_commit:\n"
+            "  default: false\n"
+            "  after_constitution:\n"
+            "    enabled: true\n"
+        ))
+        memory_dir = project / ".specify" / "memory"
+        memory_dir.mkdir(parents=True, exist_ok=True)
+        (memory_dir / "constitution.md").write_text("principles")
+        (project / "unrelated.txt").write_text("out of scope")
+
+        result = _run_bash("auto-commit.sh", project, "after_constitution")
+        assert result.returncode == 0
+
+        show = subprocess.run(
+            ["git", "show", "--stat", "--oneline", "HEAD"],
+            cwd=project, capture_output=True, text=True,
+        )
+        assert "constitution.md" in show.stdout
+        assert "unrelated.txt" not in show.stdout
+        status = subprocess.run(
+            ["git", "status", "--porcelain", "--", "unrelated.txt"],
+            cwd=project, capture_output=True, text=True,
+        )
+        assert status.stdout.strip() == "?? unrelated.txt"
+
+    def test_unresolvable_feature_stages_tracked_files_only(self, tmp_path: Path):
+        """With no feature.json (and no SPECIFY_FEATURE_DIRECTORY), a
+        modified tracked file is still committed (`git add -u`), but a new
+        untracked file elsewhere is not."""
+        project = _setup_project(tmp_path)
+        _write_config(project, (
+            "auto_commit:\n"
+            "  default: false\n"
+            "  after_specify:\n"
+            "    enabled: true\n"
+        ))
+        tracked = project / "tracked.txt"
+        tracked.write_text("v1")
+        subprocess.run(["git", "add", "tracked.txt"], cwd=project, check=True)
+        subprocess.run(
+            ["git", "commit", "-q", "-m", "seed tracked"],
+            cwd=project, check=True, env={**os.environ, **_GIT_ENV},
+        )
+        tracked.write_text("v2")
+        (project / "unrelated.txt").write_text("out of scope")
+
+        result = _run_bash("auto-commit.sh", project, "after_specify")
+        assert result.returncode == 0
+
+        show = subprocess.run(
+            ["git", "show", "--stat", "--oneline", "HEAD"],
+            cwd=project, capture_output=True, text=True,
+        )
+        assert "tracked.txt" in show.stdout
+        assert "unrelated.txt" not in show.stdout
+        status = subprocess.run(
+            ["git", "status", "--porcelain", "--", "unrelated.txt"],
+            cwd=project, capture_output=True, text=True,
+        )
+        assert status.stdout.strip() == "?? unrelated.txt"
+
+    def test_implement_events_stage_source_outside_feature_directory(self, tmp_path: Path):
+        """before_implement and after_implement commit implementation code
+        wherever it lands in the tree, not just specs/<feature>/: unlike
+        every other event, these two keep the repo-wide `git add -A`
+        because the command they follow produces code outside the feature
+        directory."""
+        project = _setup_project_with_feature(tmp_path)
+        _write_config(project, (
+            "auto_commit:\n"
+            "  default: false\n"
+            "  after_implement:\n"
+            "    enabled: true\n"
+        ))
+        (project / "specs" / "001-test" / "tasks.md").write_text("- [X] T001 done\n")
+        (project / "src").mkdir()
+        (project / "src" / "app.py").write_text("print('hello')\n")
+
+        result = _run_bash("auto-commit.sh", project, "after_implement")
+        assert result.returncode == 0
+
+        show = subprocess.run(
+            ["git", "show", "--stat", "--oneline", "HEAD"],
+            cwd=project, capture_output=True, text=True,
+        )
+        assert "tasks.md" in show.stdout
+        assert "app.py" in show.stdout
+
