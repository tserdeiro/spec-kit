+"""Preset installation preserves modes on generated scripts."""
+
+import os
+
+import pytest
+
+from specify_cli.bundler.models.manifest import ComponentRef
+from specify_cli.bundler.services.adapters import DefaultPrimitiveInstaller
+from specify_cli.presets import PresetManager
+from tests.integrations.test_integration_subcommand import _init_project
+
+
+def _write_mode_preset(tmp_path):
+    preset_src = tmp_path / "mode-preset"
+    (preset_src / "commands").mkdir(parents=True)
+    (preset_src / "commands" / "speckit.specify.md").write_text(
+        "---\ndescription: Mode test\n---\nPreset content\n", encoding="utf-8"
+    )
+    (preset_src / "preset.yml").write_text(
+        """schema_version: '1.0'
+preset:
+  id: mode-preset
+  name: Mode Preset
+  version: 1.0.0
+  description: Test preset
+requires:
+  speckit_version: '>=0.1.0'
+provides:
+  templates:
+    - type: command
+      name: speckit.specify
+      file: commands/speckit.specify.md
+""",
+        encoding="utf-8",
+    )
+    return preset_src
+
+
+def _remove_execute_bits(project):
+    script = project / ".specify" / "scripts" / "bash" / "check-prerequisites.sh"
+    assert script.is_file()
+    script.chmod(0o644)
+    assert not (script.stat().st_mode & 0o111)
+    return script
+
+
+@pytest.mark.skipif(os.name == "nt", reason="POSIX execute bits are not meaningful on Windows")
+def test_preset_manager_install_restores_existing_script_mode(tmp_path):
+    """The shared preset install sink restores the generated script invariant."""
+    project = _init_project(tmp_path, "claude")
+    script = _remove_execute_bits(project)
+    preset_src = _write_mode_preset(tmp_path)
+
+    PresetManager(project).install_from_directory(preset_src, "1.0.4")
+
+    assert script.stat().st_mode & 0o111
+
+
+@pytest.mark.skipif(os.name == "nt", reason="POSIX execute bits are not meaningful on Windows")
+def test_bundle_preset_route_restores_existing_script_mode(tmp_path, monkeypatch):
+    """The bundle primitive route reaches the shared preset install sink."""
+    project = _init_project(tmp_path, "claude")
+    script = _remove_execute_bits(project)
+    preset_src = _write_mode_preset(tmp_path)
+
+    monkeypatch.setattr(
+        "specify_cli._assets._locate_bundled_preset",
+        lambda preset_id: preset_src if preset_id == "mode-preset" else None,
+    )
+    DefaultPrimitiveInstaller(allow_network=False).install(
+        project, ComponentRef(kind="presets", id="mode-preset")
+    )
+
+    assert script.stat().st_mode & 0o111
