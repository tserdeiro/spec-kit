+    def test_extension_path_rewrite_preserves_data_fence_paths(self, tmp_path):
+        """Rendered commands keep data examples while shell references relocate."""
+        from specify_cli.agents import CommandRegistrar
+
+        extension_dir = tmp_path / "extension"
+        commands_dir = extension_dir / "commands"
+        (extension_dir / "src").mkdir(parents=True)
+        commands_dir.mkdir()
+        (commands_dir / "speckit.example.md").write_text(
+            '''---
+description: Example
+---
+Findings example:
+
+   ~~~~json extra-info
+   {"path": "src/module.py", "package": "src/package.json", "script": "scripts/example.sh", "escaped": "src/with\\\"quote.py"}
+   ~~~~~~
+
+Run the packaged checker:
+
+```bash
+python src/check.py
+```
+
+The package metadata is in src/package.json and the helper is scripts/helper.sh.
+''',
+            encoding="utf-8",
+        )
+
+        registrar = CommandRegistrar()
+        registered = registrar.register_commands(
+            "claude",
+            [{"name": "speckit.example", "file": "commands/speckit.example.md"}],
+            "code-review",
+            extension_dir,
+            tmp_path / "project",
+            extension_id="code-review",
+        )
+
+        assert registered == ["speckit.example"]
+        rendered = (
+            tmp_path / "project" / ".claude" / "skills" / "speckit-example" / "SKILL.md"
+        ).read_text(encoding="utf-8")
+        assert '"path": "src/module.py"' in rendered
+        assert '"package": "src/package.json"' in rendered
+        assert '"script": "scripts/example.sh"' in rendered
+        assert '"escaped": "src/with\\\"quote.py"' in rendered
+        assert "python .specify/extensions/code-review/src/check.py" in rendered
+        assert ".specify/extensions/code-review/src/package.json" in rendered
+        assert ".specify/extensions/code-review/scripts/helper.sh" in rendered
+
+    def test_nested_data_fences_survive_both_path_rewrite_passes(self, tmp_path):
+        """Nested list examples stay literal through project and extension rewrites."""
+        from specify_cli.agents import CommandRegistrar
+
+        extension_dir = tmp_path / "extension"
+        (extension_dir / "src").mkdir(parents=True)
+        text = """- Configuration:
+  ```json
+  {"path": "src/config.json", "script": "scripts/run.sh"}
+  ```
+- Run:
+  ```bash
+  python src/check.py
+  ```
+"""
+
+        project_rewritten = CommandRegistrar.rewrite_project_relative_paths(
+            text, extension_id="code-review"
+        )
+        both_rewritten = CommandRegistrar.rewrite_extension_paths(
+            project_rewritten, "code-review", extension_dir
+        )
+
+        assert '"path": "src/config.json"' in both_rewritten
+        assert '"script": "scripts/run.sh"' in both_rewritten
+        assert "python .specify/extensions/code-review/src/check.py" in both_rewritten
+
