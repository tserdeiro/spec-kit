+_DATA_FENCE_LANGUAGES = {"json", "jsonc", "yaml", "yml", "toml", "xml", "csv"}
+_MARKDOWN = MarkdownIt("commonmark")
+
+
+def _rewrite_outside_data_fences(text: str, rewrite: Callable[[str], str]) -> str:
+    """Rewrite command text while retaining paths in illustrative data fences."""
+    lines = text.splitlines(keepends=True)
+    protected: list[tuple[int, int]] = []
+    for token in _MARKDOWN.parse(text):
+        if token.type != "fence" or not token.map:
+            continue
+        language = token.info.split(None, 1)[0].lower() if token.info else ""
+        if language in _DATA_FENCE_LANGUAGES:
+            protected.append((token.map[0], token.map[1]))
+
+    parts: list[str] = []
+    cursor = 0
+    for start, end in protected:
+        parts.append(rewrite("".join(lines[cursor:start])))
+        parts.append("".join(lines[start:end]))
+        cursor = end
+    parts.append(rewrite("".join(lines[cursor:])))
+    return "".join(parts)
+
+
