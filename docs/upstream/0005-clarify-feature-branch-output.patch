new file mode 100644
index 0000000..29e1742
--- /dev/null
+++ b/tests/test_git_extension_branch_output.py
@@ -0,0 +1,85 @@
+"""Contract tests for the native git extension branch hook variants."""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from tests.parity_helpers import HAS_POWERSHELL, POWERSHELL_EXE, clean_env, run
+
+ROOT = Path(__file__).resolve().parent.parent
+EXTENSION = ROOT / "extensions" / "git" / "scripts"
+
+
+@pytest.fixture
+def consumer(tmp_path: Path) -> Path:
+    subprocess.run(["git", "init", "-q"], cwd=tmp_path, check=True)
+    subprocess.run(["git", "config", "user.email", "test@example.com"], cwd=tmp_path, check=True)
+    subprocess.run(["git", "config", "user.name", "Test User"], cwd=tmp_path, check=True)
+    subprocess.run(["git", "commit", "--allow-empty", "-qm", "init"], cwd=tmp_path, check=True)
+    for kind, filename in (("bash", "create-new-feature-branch.sh"),
+                           ("powershell", "create-new-feature-branch.ps1"),
+                           ("python", "create_new_feature_branch.py")):
+        target = tmp_path / ".specify" / "extensions" / "git" / "scripts" / kind
+        target.mkdir(parents=True)
+        shutil.copy(EXTENSION / kind / filename, target / filename)
+    for kind, filename in (("bash", "common.sh"), ("powershell", "common.ps1"), ("python", "common.py")):
+        target = tmp_path / ".specify" / "scripts" / kind
+        target.mkdir(parents=True)
+        shutil.copy(ROOT / "scripts" / kind / filename, target / filename)
+    return tmp_path
+
+
+def _variants(repo: Path):
+    variants = [
+        ("bash", ["bash", str(repo / ".specify/extensions/git/scripts/bash/create-new-feature-branch.sh")]),
+        ("python", [sys.executable, str(repo / ".specify/extensions/git/scripts/python/create_new_feature_branch.py")]),
+    ]
+    if HAS_POWERSHELL:
+        variants.append(("powershell", [
+            POWERSHELL_EXE,
+            "-NoProfile",
+            "-File",
+            str(repo / ".specify/extensions/git/scripts/powershell/create-new-feature-branch.ps1"),
+        ]))
+    return variants
+
+
+def test_json_stdout_has_no_persistence_noise_and_quotes_description(consumer: Path) -> None:
+    env = clean_env()
+    results = []
+    for kind, command in _variants(consumer):
+        if kind == "powershell":
+            command.extend(["-Json", "-AllowExistingBranch", "Add Bob's feature"])
+        else:
+            command.extend(["--json", "--allow-existing-branch", "Add Bob's feature"])
+        results.append(run(command, consumer, env))
+
+    assert all(result.returncode == 0 for result in results), [
+        (result.returncode, result.stdout, result.stderr) for result in results
+    ]
+    assert all("bob" in json.loads(result.stdout)["BRANCH_NAME"] for result in results)
+    assert all("feature" in json.loads(result.stdout)["BRANCH_NAME"] for result in results)
+    assert all(result.stderr == "" for result in results)
+    assert all("To persist" not in result.stdout + result.stderr for result in results)
+
+
+def test_text_output_explains_feature_json_persistence(consumer: Path) -> None:
+    env = clean_env()
+    env["GIT_BRANCH_NAME"] = "001-text-contract"
+    command = [
+        "bash",
+        str(consumer / ".specify/extensions/git/scripts/bash/create-new-feature-branch.sh"),
+        "--short-name",
+        "text",
+        "Text feature",
+    ]
+    result = run(command, consumer, env)
+    assert result.returncode == 0
+    assert ".specify/feature.json" in result.stdout
+    assert "export SPECIFY_FEATURE" not in result.stdout + result.stderr
