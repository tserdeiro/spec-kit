diff --git a/src/specify_cli/extensions/__init__.py b/src/specify_cli/extensions/__init__.py
index 3968e4f..150290d 100644
--- a/src/specify_cli/extensions/__init__.py
+++ b/src/specify_cli/extensions/__init__.py
@@ -4735,6 +4735,166 @@ class ConfigManager:
         return True
 
 
+class _ConditionSyntaxError(Exception):
+    """A hook condition does not parse. Always caught; the caller falls
+    back to False, the same default an unrecognized atom already had."""
+
+
+# The five condition forms `_evaluate_condition` has always supported, plus
+# "is not set" (added alongside `and`/`or`/`not`/parentheses below). Each
+# pattern serves two purposes with the same compiled object: `.match()` at a
+# tokenizer position finds an atom's extent, and `.fullmatch()` against that
+# isolated text dispatches its evaluation -- so the shape of an atom is
+# defined exactly once.
+_CONFIG_IS_SET_RE = re.compile(
+    r"config\.([a-z0-9_.]+)\s+is\s+(?:(not)\s+)?set", re.IGNORECASE
+)
+_CONFIG_CMP_RE = re.compile(
+    r'config\.([a-z0-9_.]+)\s*(==|!=)\s*["\']([^"\']+)["\']', re.IGNORECASE
+)
+_ENV_IS_SET_RE = re.compile(
+    r"env\.([A-Z0-9_]+)\s+is\s+(?:(not)\s+)?set", re.IGNORECASE
+)
+_ENV_CMP_RE = re.compile(
+    r'env\.([A-Z0-9_]+)\s*(==|!=)\s*["\']([^"\']+)["\']', re.IGNORECASE
+)
+_ATOM_PATTERNS = (_CONFIG_IS_SET_RE, _CONFIG_CMP_RE, _ENV_IS_SET_RE, _ENV_CMP_RE)
+
+# `and`/`or`/`not`, case-insensitive, as a whole word -- tried only after
+# every atom pattern above has already had a chance to match at the same
+# position, so "is not set" is consumed whole by an atom pattern before this
+# ever gets to treat its "not" as the unary operator, and a quoted value
+# containing "and"/"or"/"not" is consumed whole by a cmp pattern's quoted
+# group before this regex is tried at all.
+_CONDITION_KEYWORD_RE = re.compile(r"(and|or|not)\b", re.IGNORECASE)
+
+
+def _tokenize_condition(condition: str) -> list[tuple[str, str]]:
+    """Tokenize a hook condition into ATOM/AND/OR/NOT/LPAREN/RPAREN tokens.
+
+    Whitespace between tokens is insignificant and skipped. Raises
+    _ConditionSyntaxError on any text that is not one of those -- an
+    unrecognized atom shape, a stray character, or anything else -- which
+    callers treat the same as any other malformed condition (False).
+    """
+    tokens: list[tuple[str, str]] = []
+    pos = 0
+    length = len(condition)
+    while pos < length:
+        ch = condition[pos]
+        if ch.isspace():
+            pos += 1
+            continue
+        if ch == "(":
+            tokens.append(("LPAREN", ch))
+            pos += 1
+            continue
+        if ch == ")":
+            tokens.append(("RPAREN", ch))
+            pos += 1
+            continue
+
+        atom_match = None
+        for pattern in _ATOM_PATTERNS:
+            atom_match = pattern.match(condition, pos)
+            if atom_match:
+                break
+        if atom_match:
+            tokens.append(("ATOM", atom_match.group(0)))
+            pos = atom_match.end()
+            continue
+
+        keyword_match = _CONDITION_KEYWORD_RE.match(condition, pos)
+        if keyword_match:
+            tokens.append((keyword_match.group(1).upper(), keyword_match.group(0)))
+            pos = keyword_match.end()
+            continue
+
+        raise _ConditionSyntaxError(f"unrecognized condition text at position {pos}")
+
+    return tokens
+
+
+class _ConditionParser:
+    """Recursive-descent evaluator for the composite condition grammar.
+
+        expression := or_expr
+        or_expr    := and_expr (OR and_expr)*
+        and_expr   := not_expr (AND not_expr)*
+        not_expr   := NOT not_expr | primary
+        primary    := LPAREN or_expr RPAREN | ATOM
+
+    `not` binds tightest, then `and`, then `or`. This evaluates straight to
+    a bool as it parses rather than building a separate AST -- the grammar
+    is small enough that the parse and the result coincide, and both sides
+    of `and`/`or` are always parsed (never skipped for short-circuiting),
+    so a malformed right-hand side is still caught even when the left side
+    alone would already decide the outcome.
+
+    Any malformed input -- unbalanced parentheses, an operator with a
+    missing operand, leftover tokens after a complete expression --
+    raises _ConditionSyntaxError; `_evaluate_condition` catches it and
+    returns False, the existing failure default.
+    """
+
+    def __init__(self, tokens: list[tuple[str, str]], evaluate_atom: Callable[[str], bool]):
+        self._tokens = tokens
+        self._pos = 0
+        self._evaluate_atom = evaluate_atom
+
+    def parse(self) -> bool:
+        if not self._tokens:
+            raise _ConditionSyntaxError("empty condition")
+        result = self._or_expr()
+        if self._pos != len(self._tokens):
+            raise _ConditionSyntaxError("trailing text after a complete expression")
+        return result
+
+    def _peek_kind(self) -> Optional[str]:
+        return self._tokens[self._pos][0] if self._pos < len(self._tokens) else None
+
+    def _advance(self) -> tuple[str, str]:
+        token = self._tokens[self._pos]
+        self._pos += 1
+        return token
+
+    def _or_expr(self) -> bool:
+        result = self._and_expr()
+        while self._peek_kind() == "OR":
+            self._advance()
+            rhs = self._and_expr()
+            result = result or rhs
+        return result
+
+    def _and_expr(self) -> bool:
+        result = self._not_expr()
+        while self._peek_kind() == "AND":
+            self._advance()
+            rhs = self._not_expr()
+            result = result and rhs
+        return result
+
+    def _not_expr(self) -> bool:
+        if self._peek_kind() == "NOT":
+            self._advance()
+            return not self._not_expr()
+        return self._primary()
+
+    def _primary(self) -> bool:
+        kind = self._peek_kind()
+        if kind == "LPAREN":
+            self._advance()
+            result = self._or_expr()
+            if self._peek_kind() != "RPAREN":
+                raise _ConditionSyntaxError("expected ')'")
+            self._advance()
+            return result
+        if kind == "ATOM":
+            _, text = self._advance()
+            return self._evaluate_atom(text)
+        raise _ConditionSyntaxError(f"expected an atom, '(' or 'not', found {kind!r}")
+
+
 class HookExecutor:
     """Manages extension hook execution."""
 
