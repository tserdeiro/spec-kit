+
+        Returns:
+            True if the atom holds, False otherwise.
+        """
+        if match := _CONFIG_IS_SET_RE.fullmatch(atom):
+            key_path, negate = match.group(1), match.group(2)
             if not extension_id:
                 return False
 
             config_manager = ConfigManager(self.project_root, extension_id)
-            return config_manager.has_value(key_path)
+            has_value = config_manager.has_value(key_path)
+            return (not has_value) if negate else has_value
 
-        # Pattern: "config.key.path == 'value'" or "config.key.path != 'value'"
-        if match := re.match(
-            r'config\.([a-z0-9_.]+)\s*(==|!=)\s*["\']([^"\']+)["\']',
-            condition,
-            re.IGNORECASE,
-        ):
-            key_path = match.group(1)
-            operator = match.group(2)
-            expected_value = match.group(3)
+        if match := _CONFIG_CMP_RE.fullmatch(atom):
+            key_path, operator, expected_value = match.groups()
 
