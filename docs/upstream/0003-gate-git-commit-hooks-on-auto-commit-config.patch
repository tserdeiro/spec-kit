+        """Evaluate a single condition atom.
 
-        # Pattern: "config.key.path is set"
-        if match := re.match(
-            r"config\.([a-z0-9_.]+)\s+is\s+set", condition, re.IGNORECASE
-        ):
-            key_path = match.group(1)
+        Supported condition patterns:
+        - "config.key.path is set" / "is not set" - config value (non-)existence
+        - "config.key.path == 'value'" / "!= 'value'" - config value (in)equality
+        - "env.VAR_NAME is set" / "is not set" - env var (non-)existence
