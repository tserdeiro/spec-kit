@@ -0,0 +1,96 @@
+"""Command templates evaluate a hook's `condition` instead of skipping it.
+
+`extensions/git/extension.yml` gates the sixteen optional `git.commit` hooks
+on `condition: "config.auto_commit.<event>.enabled == 'true'"`, a grammar
+`HookExecutor._evaluate_condition` already supports -- but a condition only
+matters if something evaluates it. Every hook block in
+`templates/commands/*.md` used to instruct the agent to skip any hook with a
+non-empty `condition` and "leave condition evaluation to the HookExecutor
+implementation", and nothing in `src/specify_cli` calls
+`HookExecutor.should_execute_hook` in production, so the condition was
+inert: a project that turned an event's auto-commit on would still never be
+offered the hook.
+
+These tests pin that every stock command template with a hook block now
+tells the agent to evaluate the condition itself -- in wording identical
+across every block, so no command's phrasing is more authoritative than
+another's -- and that the old skip-unconditionally sentence is gone.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import pytest
+
+REPO_ROOT = Path(__file__).parent.parent
+TEMPLATES_DIR = REPO_ROOT / "templates" / "commands"
+
+_HOOK_EVENT = re.compile(r"hooks\.(before|after)_")
+_OLD_SKIP_SENTENCE = "leave condition evaluation to the HookExecutor implementation"
+
+# The evaluation-rule paragraph: the "For each remaining hook, evaluate ..."
+# intro line through its four two-space-indented bullets, stopping just
+# before the "For each executable hook, ..." line every hook block ends
+# with (indented at the top list level, not two-space nested).
+_RULE_BLOCK = re.compile(
+    r"- For each remaining hook, evaluate its `condition`.*\n"
+    r"(?:  - .*\n)+"
+)
+
+HOOK_TEMPLATES = sorted(
+    p.name
+    for p in TEMPLATES_DIR.glob("*.md")
+    if _HOOK_EVENT.search(p.read_text(encoding="utf-8"))
+)
+
+
+def test_hook_templates_discovered():
+    # Guard: every stock command template ships before_/after_ hook blocks;
+    # if the glob ever found none, the parametrized tests below would
+    # silently pass over an empty set.
+    assert "implement.md" in HOOK_TEMPLATES
+    assert "plan.md" in HOOK_TEMPLATES
+    assert len(HOOK_TEMPLATES) == 10
+
+
+@pytest.mark.parametrize("name", HOOK_TEMPLATES)
+def test_template_no_longer_skips_conditioned_hooks(name: str):
+    content = (TEMPLATES_DIR / name).read_text(encoding="utf-8")
+    assert _OLD_SKIP_SENTENCE not in content, (
+        f"{name} still tells the agent to leave a conditioned hook unevaluated"
+    )
+
+
+@pytest.mark.parametrize("name", HOOK_TEMPLATES)
+def test_template_has_one_evaluation_block_per_hook_event(name: str):
+    # Every stock template gates exactly one before_ and one after_ event.
+    content = (TEMPLATES_DIR / name).read_text(encoding="utf-8")
+    blocks = _RULE_BLOCK.findall(content)
+    assert len(blocks) == 2, f"{name}: expected 2 evaluation blocks, found {len(blocks)}"
+
+
+def test_evaluation_rule_is_identical_across_every_block():
+    # The rule must read the same everywhere: an agent evaluating a hook for
+    # one command should not find different wording for another.
+    blocks: set[str] = set()
+    for name in HOOK_TEMPLATES:
+        content = (TEMPLATES_DIR / name).read_text(encoding="utf-8")
+        blocks.update(_RULE_BLOCK.findall(content))
+    assert len(blocks) == 1, f"evaluation rule text diverges across blocks: {sorted(blocks)}"
+
+    block = next(iter(blocks))
+    # No condition -> executable.
+    assert "No `condition` field, or a null/empty one, means the hook is executable." in block
+    # config.<path> forms, read from the extension's merged configuration.
+    assert "HookExecutor._evaluate_condition" in block
+    assert "config.<key.path> is set" in block
+    assert ".specify/extensions/<extension>/<extension>-config.yml" in block
+    assert "a key missing from every layer is never `is set`, never `==` a value, and always `!=` a value" in block
+    # env.<VAR> forms, read from the process environment.
+    assert "env.<VAR_NAME> is set" in block
+    assert "read the process environment the same way" in block
+    # Failure default: unrecognized expression or unreadable config -> skip.
+    assert "config file that can't be read or parsed" in block
+    assert "should_execute_hook" in block
