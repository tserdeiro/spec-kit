@@ -0,0 +1,259 @@
+"""Grammar tests for `HookExecutor._evaluate_condition`'s composite conditions.
+
+`_evaluate_condition` composes its five atom forms -- `config.<path>` /
+`env.<VAR>` with `is set`, `is not set`, `==`, and `!=` -- with `and`, `or`,
+`not`, and parentheses. `not` binds tightest, then `and`, then `or`;
+keywords are case-insensitive, and a quoted value may itself contain one
+(e.g. `== 'a and b'`). Anything that doesn't fully parse this way --
+unbalanced parentheses, an unrecognized atom, trailing text after a valid
+atom, an operator with a missing operand -- evaluates False, the same
+failure default an unrecognized atom always had.
+
+These tests exercise the grammar's mechanics through `env.<VAR>` atoms,
+which need only environment variables to set up. `config.<path>` atoms use
+the identical tokenizer/parser and are covered against a real extension
+configuration by tests/extensions/git/test_git_extension.py (the sixteen
+`git.commit` hooks' composite condition, proven to agree with
+`auto_commit.py`'s own resolution) and by the pre-existing
+tests/test_extensions.py condition tests.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from specify_cli.extensions import HookExecutor
+
+
+@pytest.fixture()
+def executor(tmp_path: Path) -> HookExecutor:
+    # Only env.<VAR> atoms are exercised via this fixture, so the project
+    # root is never actually read from disk.
+    return HookExecutor(tmp_path)
+
+
+def _ev(executor: HookExecutor, condition: str) -> bool:
+    return executor._evaluate_condition(condition, extension_id=None)
+
+
+class TestBooleanComposition:
+    @pytest.mark.parametrize(
+        "a, b, expected",
+        [
+            (True, True, True),
+            (True, False, False),
+            (False, True, False),
+            (False, False, False),
+        ],
+    )
+    def test_and(self, executor, monkeypatch, a, b, expected):
+        monkeypatch.setenv("A", "true" if a else "false")
+        monkeypatch.setenv("B", "true" if b else "false")
+        assert _ev(executor, "env.A == 'true' and env.B == 'true'") is expected
+
+    @pytest.mark.parametrize(
+        "a, b, expected",
+        [
+            (True, True, True),
+            (True, False, True),
+            (False, True, True),
+            (False, False, False),
+        ],
+    )
+    def test_or(self, executor, monkeypatch, a, b, expected):
+        monkeypatch.setenv("A", "true" if a else "false")
+        monkeypatch.setenv("B", "true" if b else "false")
+        assert _ev(executor, "env.A == 'true' or env.B == 'true'") is expected
+
+    @pytest.mark.parametrize("a, expected", [(True, False), (False, True)])
+    def test_not(self, executor, monkeypatch, a, expected):
+        monkeypatch.setenv("A", "true" if a else "false")
+        assert _ev(executor, "not env.A == 'true'") is expected
+
+    def test_double_not(self, executor, monkeypatch):
+        monkeypatch.setenv("A", "true")
+        assert _ev(executor, "not not env.A == 'true'") is True
+
+    def test_three_way_or(self, executor, monkeypatch):
+        monkeypatch.setenv("A", "false")
+        monkeypatch.setenv("B", "false")
+        monkeypatch.setenv("C", "true")
+        assert _ev(executor, "env.A == 'true' or env.B == 'true' or env.C == 'true'") is True
+
+    def test_three_way_and(self, executor, monkeypatch):
+        monkeypatch.setenv("A", "true")
+        monkeypatch.setenv("B", "true")
+        monkeypatch.setenv("C", "false")
+        assert _ev(executor, "env.A == 'true' and env.B == 'true' and env.C == 'true'") is False
+
+
+class TestPrecedence:
+    def test_and_binds_tighter_than_or(self, executor, monkeypatch):
+        # "A or B and C" must parse as "A or (B and C)":
+        #   true or (false and false) = True.
+        # A left-to-right misparse, "(A or B) and C", would instead give
+        #   (true or false) and false = False.
+        # The two readings disagree, so this pins that `and` binds tighter.
+        monkeypatch.setenv("A", "true")
+        monkeypatch.setenv("B", "false")
+        monkeypatch.setenv("C", "false")
+        assert _ev(executor, "env.A == 'true' or env.B == 'true' and env.C == 'true'") is True
+
+    def test_not_binds_tighter_than_and(self, executor, monkeypatch):
+        # "not A and B" must parse as "(not A) and B":
+        #   (not true) and false = False.
+        # A misparse of "not (A and B)" would instead give
+        #   not (true and false) = True.
+        # The two readings disagree, so this pins that `not` binds to A alone.
+        monkeypatch.setenv("A", "true")
+        monkeypatch.setenv("B", "false")
+        assert _ev(executor, "not env.A == 'true' and env.B == 'true'") is False
+
+    def test_parentheses_override_precedence(self, executor, monkeypatch):
+        # Same values as test_and_binds_tighter_than_or, but parenthesized
+        # as "(A or B) and C": (true or false) and false = False, the
+        # opposite of that test's unparenthesized result -- proving the
+        # parentheses actually regroup rather than being ignored.
+        monkeypatch.setenv("A", "true")
+        monkeypatch.setenv("B", "false")
+        monkeypatch.setenv("C", "false")
+        assert _ev(executor, "(env.A == 'true' or env.B == 'true') and env.C == 'true'") is False
+
+    def test_nested_parentheses(self, executor, monkeypatch):
+        monkeypatch.setenv("A", "true")
+        monkeypatch.setenv("B", "false")
+        monkeypatch.setenv("C", "true")
+        condition = (
+            "env.A == 'true' and "
+            "(env.B == 'true' or (env.C == 'true' and not env.B == 'true'))"
+        )
+        assert _ev(executor, condition) is True
+
+
+class TestIsNotSet:
+    def test_not_of_a_parenthesized_group(self, executor, monkeypatch):
+        monkeypatch.setenv("A", "true")
+        monkeypatch.setenv("B", "false")
+        assert _ev(executor, "not (env.A == 'true' or env.B == 'true')") is False
+        assert _ev(executor, "not (env.A == 'false' or env.B == 'true')") is True
+
+    def test_nesting_past_any_sane_depth_is_false_not_an_error(self, executor, monkeypatch):
+        monkeypatch.setenv("A", "true")
+        assert _ev(executor, "(" * 3000 + "env.A == 'true'" + ")" * 3000) is False
+
+    def test_is_not_set_true_when_absent(self, executor, monkeypatch):
+        monkeypatch.delenv("MISSING_VAR", raising=False)
+        assert _ev(executor, "env.MISSING_VAR is not set") is True
+
+    def test_is_not_set_false_when_present(self, executor, monkeypatch):
+        monkeypatch.setenv("PRESENT_VAR", "anything")
+        assert _ev(executor, "env.PRESENT_VAR is not set") is False
+
+    def test_is_set_and_is_not_set_are_complements(self, executor, monkeypatch):
+        monkeypatch.setenv("V", "x")
+        assert _ev(executor, "env.V is set") is True
+        assert _ev(executor, "env.V is not set") is False
+
+    def test_config_is_not_set_on_unconfigured_extension(self, tmp_path: Path):
+        # No extension.yml, no <ext>-config.yml -- the merged config is {},
+        # so has_value is False and "is not set" is True.
+        executor = HookExecutor(tmp_path)
+        assert executor._evaluate_condition("config.anything is not set", "git") is True
+
+    def test_composite_matches_auto_commit_fallback_shape(self, tmp_path: Path, monkeypatch):
+        # The exact composite shape used to gate the sixteen git.commit
+        # hooks: the per-event key wins when it is set, otherwise fall back
+        # to a default. No config.* value is configured for "git" here, so
+        # both config.*.enabled atoms are "not set" and the result reduces
+        # to whatever the env-backed stand-in for the default says.
+        executor = HookExecutor(tmp_path)
+        monkeypatch.setenv("DEFAULT_TRUE", "true")
+        condition = (
+            "config.auto_commit.before_plan.enabled == 'true' or "
+            "(config.auto_commit.before_plan.enabled is not set and "
+            "env.DEFAULT_TRUE == 'true')"
+        )
+        assert executor._evaluate_condition(condition, "git") is True
+
+
+class TestCaseInsensitiveKeywords:
+    @pytest.mark.parametrize(
+        "condition",
+        [
+            "env.A == 'true' and env.B == 'true'",
+            "env.A == 'true' AND env.B == 'true'",
+            "env.A == 'true' And env.B == 'true'",
+            "env.A == 'true' aNd env.B == 'true'",
+        ],
+    )
+    def test_and_case_insensitive(self, executor, monkeypatch, condition):
+        monkeypatch.setenv("A", "true")
+        monkeypatch.setenv("B", "true")
+        assert _ev(executor, condition) is True
+
+    @pytest.mark.parametrize("keyword", ["not", "NOT", "Not", "nOT"])
+    def test_not_case_insensitive(self, executor, monkeypatch, keyword):
+        monkeypatch.setenv("A", "false")
+        assert _ev(executor, f"{keyword} env.A == 'true'") is True
+
+    @pytest.mark.parametrize("keyword", ["or", "OR", "Or"])
+    def test_or_case_insensitive(self, executor, monkeypatch, keyword):
+        monkeypatch.setenv("A", "false")
+        monkeypatch.setenv("B", "true")
+        assert _ev(executor, f"env.A == 'true' {keyword} env.B == 'true'") is True
+
+
+class TestQuotedValueMayContainKeyword:
+    def test_quoted_value_with_and_or_not(self, executor, monkeypatch):
+        monkeypatch.setenv("PHRASE", "a and b or not c")
+        assert _ev(executor, "env.PHRASE == 'a and b or not c'") is True
+
+    def test_quoted_value_with_a_parenthesis(self, executor, monkeypatch):
+        monkeypatch.setenv("PHRASE", "a)b")
+        assert _ev(executor, "env.PHRASE == 'a)b'") is True
+        assert _ev(executor, "(env.PHRASE == 'a)b')") is True
+
+    def test_quoted_keyword_value_is_compared_in_full(self, executor, monkeypatch):
+        # If the tokenizer mistakenly treated "and" inside the quotes as the
+        # boolean operator, this would either fail to parse or compare only
+        # part of the value. It must compare the whole quoted string.
+        monkeypatch.setenv("PHRASE", "a and c")
+        assert _ev(executor, "env.PHRASE == 'a and b'") is False
+
+    def test_quoted_keyword_value_still_composes(self, executor, monkeypatch):
+        monkeypatch.setenv("PHRASE", "a and b")
+        monkeypatch.delenv("OTHER", raising=False)
+        assert _ev(executor, "env.PHRASE == 'a and b' or env.OTHER == 'true'") is True
+
+
+class TestMalformedConditionsEvaluateFalse:
+    @pytest.mark.parametrize(
+        "condition",
+        [
+            "",  # empty
+            "   ",  # whitespace only
+            "(env.A == 'true'",  # unbalanced: missing ')'
+            "env.A == 'true')",  # unbalanced: stray ')'
+            "((env.A == 'true')",  # unbalanced: 2 open, 1 close
+            "(env.A == 'true'))",  # unbalanced: 1 open, 2 close
+            "()",  # empty parentheses: no atom inside
+            "( )",  # empty parentheses with whitespace
+            "foo.bar == 'true'",  # unknown atom: not config./env.
+            "config.x.y",  # config path with no operator/"is set"
+            "env.A == true",  # unquoted comparison value
+            "env.A == 'true' garbage",  # trailing text after a valid atom
+            "env.A == 'true' env.B == 'true'",  # two atoms, no connective
+            "and",  # lone operator, no operand
+            "or",  # lone operator, no operand
+            "not",  # lone operator, no operand
+            "env.A == 'true' and",  # dangling `and` with no right operand
+            "env.A == 'true' and and env.B == 'true'",  # doubled operator
+            "env.A == 'true' and or env.B == 'true'",  # operator where an atom is expected
+            "not or env.A == 'true'",  # `not` applied to a non-atom
+            "env.A == 'true",  # atom text itself malformed: unterminated quote
+        ],
+    )
+    def test_malformed_condition_is_false(self, executor, condition):
+        assert _ev(executor, condition) is False
