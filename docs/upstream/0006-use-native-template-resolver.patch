diff --git a/tests/test_native_template_resolver_contract.py b/tests/test_native_template_resolver_contract.py
new file mode 100644
index 0000000..56e1ff9
--- /dev/null
+++ b/tests/test_native_template_resolver_contract.py
@@ -0,0 +1,41 @@
+"""Behavioral contract for the native specify template resolver."""
+
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).parent.parent
+
+
+def test_python_native_resolver_returns_composed_template_content(tmp_path: Path) -> None:
+    scripts = tmp_path / ".specify" / "scripts" / "python"
+    scripts.mkdir(parents=True)
+    shutil.copy(ROOT / "scripts/python/resolve_template.py", scripts)
+    shutil.copy(ROOT / "scripts/python/common.py", scripts)
+    templates = tmp_path / ".specify" / "templates"
+    templates.mkdir(parents=True)
+    templates.joinpath("spec-template.md").write_text(
+        "# Resolved\n\nUse the native resolver.\n", encoding="utf-8"
+    )
+
+    result = subprocess.run(
+        [sys.executable, str(scripts / "resolve_template.py"), "spec-template", "--json"],
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+    assert result.returncode == 0, result.stderr
+    payload = json.loads(result.stdout)
+    assert payload["TEMPLATE_NAME"] == "spec-template"
+    assert payload["TEMPLATE_CONTENT"] == "# Resolved\n\nUse the native resolver.\n"
+
+
+def test_specify_command_uses_native_resolver_and_template_content() -> None:
+    command = (ROOT / "templates/commands/specify.md").read_text(encoding="utf-8")
+    assert "resolve_template.py spec-template --json" in command
+    assert "TEMPLATE_CONTENT" in command
+    assert "specify preset resolve spec-template" not in command
