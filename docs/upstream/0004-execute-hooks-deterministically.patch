--- /dev/null
+++ b/tests/integrations/test_hook_renderer_matrix.py
@@ -0,0 +1,38 @@
+"""Generated integration outputs retain native hook resolution semantics."""
+
+from pathlib import Path
+
+import pytest
+
+from specify_cli.extensions import HookExecutor
+from specify_cli.integrations import get_integration
+from specify_cli.integrations.manifest import IntegrationManifest
+
+
+@pytest.mark.parametrize("integration_key", ["agy", "claude", "cline", "codex", "copilot", "junie"])
+def test_generated_commands_use_both_lifecycle_resolvers(tmp_path: Path, integration_key: str):
+    integration = get_integration(integration_key)
+    manifest = IntegrationManifest(integration_key, tmp_path)
+    integration.setup(tmp_path, manifest, script_type="sh")
+
+    generated = [p for p in tmp_path.rglob("*.md") if p.is_file()]
+    assert generated, integration_key
+    content = "\n".join(p.read_text(encoding="utf-8") for p in generated)
+    assert "specify hook check before_plan --json" in content, integration_key
+    assert "specify hook check after_plan --json" in content, integration_key
+    assert "replace dots" not in content, integration_key
+
+
+def test_resolved_hook_metadata_supplies_agent_invocation(tmp_path: Path):
+    registry = tmp_path / ".specify" / "extensions.yml"
+    registry.parent.mkdir()
+    registry.write_text(
+        "hooks:\n  before_plan:\n    - extension: test\n      command: speckit.plan\n      optional: false\n",
+        encoding="utf-8",
+    )
+
+    result = HookExecutor(tmp_path).check_hooks_for_event("before_plan")
+
+    assert result["has_hooks"] is True
+    assert result["hooks"][0]["command"] == "speckit.plan"
+    assert "EXECUTE_COMMAND_INVOCATION:" in result["message"]
