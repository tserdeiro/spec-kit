@@ -0,0 +1,191 @@
+"""CLI coverage for deterministic hook resolution."""
+
+import json
+from pathlib import Path
+
+from typer.testing import CliRunner
+import pytest
+
+from specify_cli import app
+
+
+@pytest.mark.parametrize("event", ["before_plna", "session_start", "", "after_unknown"])
+def test_hook_check_rejects_unknown_events_even_without_registry(tmp_path, monkeypatch, event):
+    monkeypatch.chdir(tmp_path)
+    result = CliRunner().invoke(app, ["hook", "check", event, "--json"])
+    assert result.exit_code == 1
+    assert "unknown lifecycle event" in result.output
+    assert "before_plan" in result.output
+    assert '"has_hooks"' not in result.output
+
+
+def test_event_catalog_matches_all_core_template_calls():
+    import re
+    from specify_cli.commands.hook import LIFECYCLE_EVENTS
+
+    templates = Path(__file__).parents[1] / "templates" / "commands"
+    emitted = []
+    for path in templates.glob("*.md"):
+        emitted.extend(re.findall(r"hook check (\w+) --json", path.read_text()))
+    assert set(emitted) == LIFECYCLE_EVENTS
+    assert len(emitted) == len(LIFECYCLE_EVENTS)
+
+
+@pytest.mark.parametrize("agent,expected", [
+    ("codex", "$speckit-git-commit"),
+    ("claude", "/speckit-git-commit"),
+    ("copilot", "/speckit-git-commit"),
+    ("cline", "/speckit-git-commit"),
+    ("junie", "/speckit-git-commit"),
+    ("kimi", "/skill:speckit-git-commit"),
+])
+def test_hook_cli_returns_exact_native_invocation(tmp_path, monkeypatch, agent, expected):
+    _write_config(tmp_path, "hooks:\n  before_plan:\n    - command: speckit.git.commit\n      optional: false\n")
+    (tmp_path / ".specify" / "init-options.json").write_text(
+        json.dumps({"ai": agent, "ai_skills": True}), encoding="utf-8"
+    )
+    monkeypatch.chdir(tmp_path)
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan", "--json"])
+    assert result.exit_code == 0, result.output
+    hook = json.loads(result.output)["hooks"][0]
+    assert hook["invocation"] == expected
+    assert hook["command"] == "speckit.git.commit"
+    assert hook["optional"] is False
+
+
+def _write_config(project: Path, text: str) -> None:
+    (project / ".specify").mkdir()
+    (project / ".specify" / "extensions.yml").write_text(text, encoding="utf-8")
+
+
+def test_hook_check_uses_native_executor_and_preserves_optional_authorization(
+    tmp_path, monkeypatch
+):
+    _write_config(
+        tmp_path,
+        """hooks:
+  before_plan:
+    - extension: first
+      command: speckit.first
+      optional: true
+      prompt: Run first?
+    - extension: second
+      command: speckit.second
+      optional: false
+      condition: env.SPECKIT_TEST_HOOK is set
+    - extension: disabled
+      command: speckit.disabled
+      enabled: false
+""",
+    )
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setenv("SPECKIT_TEST_HOOK", "1")
+
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan"])
+
+    assert result.exit_code == 0, result.output
+    assert "Optional Hook" in result.output
+    assert "EXECUTE_COMMAND: speckit.second" in result.output
+    assert "speckit.disabled" not in result.output
+
+
+def test_hook_check_fails_closed_for_unmet_condition(tmp_path, monkeypatch):
+    _write_config(
+        tmp_path,
+        """hooks:
+  after_tasks:
+    - extension: example
+      command: speckit.example
+      condition: env.SPECKIT_MISSING is set
+""",
+    )
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.delenv("SPECKIT_MISSING", raising=False)
+
+    result = CliRunner().invoke(app, ["hook", "check", "after_tasks"])
+
+    assert result.exit_code == 0, result.output
+    assert "speckit.example" not in result.output
+
+
+def test_hook_check_json_returns_native_invocation_metadata(tmp_path, monkeypatch):
+    _write_config(
+        tmp_path,
+        """hooks:
+  before_plan:
+    - extension: example
+      command: speckit.example
+      optional: true
+""",
+    )
+    monkeypatch.chdir(tmp_path)
+
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan", "--json"])
+
+    assert result.exit_code == 0, result.output
+    payload = json.loads(result.output)
+    assert payload["has_hooks"] is True
+    assert payload["hooks"][0]["command"] == "speckit.example"
+    assert payload["hooks"][0]["optional"] is True
+
+
+def test_hook_check_reports_invalid_registry(tmp_path, monkeypatch):
+    (tmp_path / ".specify").mkdir()
+    (tmp_path / ".specify" / "extensions.yml").write_text("hooks: [", encoding="utf-8")
+    monkeypatch.chdir(tmp_path)
+
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan"])
+
+    assert result.exit_code == 1
+    assert "cannot read hook registry" in result.output
+
+
+def test_hook_check_rejects_invalid_registry_shape(tmp_path, monkeypatch):
+    (tmp_path / ".specify").mkdir()
+    (tmp_path / ".specify" / "extensions.yml").write_text("hooks: []", encoding="utf-8")
+    monkeypatch.chdir(tmp_path)
+
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan"])
+
+    assert result.exit_code == 1
+    assert "hooks must be a mapping" in result.output
+
+
+@pytest.mark.parametrize("event_value", ["[null]", "missing"])
+def test_hook_check_rejects_malformed_selected_event(tmp_path, monkeypatch, event_value):
+    _write_config(tmp_path, f"hooks:\n  before_plan: {event_value}\n")
+    monkeypatch.chdir(tmp_path)
+
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan", "--json"])
+
+    assert result.exit_code == 1
+    assert "before_plan must be a list of mappings" in result.output
+
+
+def test_hook_check_rejects_malformed_condition(tmp_path, monkeypatch):
+    _write_config(
+        tmp_path,
+        "hooks:\n  before_plan:\n    - command: speckit.example\n      condition: bad condition\n",
+    )
+    monkeypatch.chdir(tmp_path)
+
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan", "--json"])
+
+    assert result.exit_code == 1
+    assert "malformed condition" in result.output
+
+
+@pytest.mark.parametrize("config,diagnostic", [
+    ("hooks: null\n", "hooks must be a mapping"),
+    ("hooks:\n  before_plan: [{}]\n", "requires a command"),
+    ('hooks:\n  before_plan:\n    - command: speckit.example\n      optional: "false"\n', "optional must be a boolean"),
+    ('hooks:\n  before_plan:\n    - command: speckit.example\n      enabled: "false"\n', "enabled must be a boolean"),
+    ("hooks:\n  before_plan:\n    - command: speckit.example\n      condition: false\n", "malformed condition"),
+])
+def test_invalid_hook_metadata_is_not_reported_as_executable(tmp_path, monkeypatch, config, diagnostic):
+    _write_config(tmp_path, config)
+    monkeypatch.chdir(tmp_path)
+    result = CliRunner().invoke(app, ["hook", "check", "before_plan", "--json"])
+    assert result.exit_code == 1
+    assert diagnostic in result.output
+    assert '"hooks":' not in result.output
