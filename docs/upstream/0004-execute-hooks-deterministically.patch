diff --git a/src/specify_cli/commands/hook.py b/src/specify_cli/commands/hook.py
new file mode 100644
index 00000000..e2fdfb38
--- /dev/null
+++ b/src/specify_cli/commands/hook.py
@@ -0,0 +1,102 @@
+"""specify hook * command handlers."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import typer
+import yaml
+
+hook_app = typer.Typer(
+    name="hook",
+    help="Resolve extension hooks for a command lifecycle event",
+    add_completion=False,
+)
+
+# These events are emitted by the core command templates. Agent runtime
+# events (session_start, pre_tool_use, etc.) belong to the event dispatcher.
+LIFECYCLE_EVENTS = frozenset(
+    f"{phase}_{command}"
+    for phase in ("before", "after")
+    for command in (
+        "analyze", "checklist", "clarify", "constitution", "converge",
+        "implement", "plan", "specify", "tasks", "taskstoissues",
+    )
+)
+
+
+@hook_app.command("check")
+def hook_check(
+    event_name: str = typer.Argument(..., help="Canonical lifecycle event name (e.g. before_plan)"),
+    json_output: bool = typer.Option(False, "--json", help="Emit structured hook metadata."),
+):
+    """Resolve enabled hooks and print their execution instructions."""
+    from ..extensions import HookExecutor
+
+    if event_name not in LIFECYCLE_EVENTS:
+        typer.echo(
+            f"unknown lifecycle event {event_name!r}; expected one of: "
+            + ", ".join(sorted(LIFECYCLE_EVENTS)),
+            err=True,
+        )
+        raise typer.Exit(code=1)
+
+    raw_config = {}
+    config_file = Path.cwd() / ".specify" / "extensions.yml"
+    if config_file.exists():
+        try:
+            raw_config = yaml.safe_load(config_file.read_text(encoding="utf-8"))
+        except (OSError, UnicodeError, yaml.YAMLError) as exc:
+            typer.echo(f"cannot read hook registry {config_file}: {exc}", err=True)
+            raise typer.Exit(code=1) from None
+        if raw_config is not None and not isinstance(raw_config, dict):
+            typer.echo(f"invalid hook registry {config_file}: expected a mapping", err=True)
+            raise typer.Exit(code=1)
+        if isinstance(raw_config, dict) and "hooks" in raw_config and not isinstance(raw_config["hooks"], dict):
+            typer.echo(f"invalid hook registry {config_file}: hooks must be a mapping", err=True)
+            raise typer.Exit(code=1)
+
+    executor = HookExecutor(Path.cwd())
+    hooks_config = (raw_config or {}).get("hooks", {})
+    if event_name in hooks_config:
+        event_hooks = hooks_config[event_name]
+        if not isinstance(event_hooks, list) or any(not isinstance(hook, dict) for hook in event_hooks):
+            typer.echo(
+                f"invalid hook registry {config_file}: {event_name} must be a list of mappings",
+                err=True,
+            )
+            raise typer.Exit(code=1)
+        for hook in event_hooks:
+            condition = hook.get("condition")
+            if not executor.is_valid_condition(condition):
+                typer.echo(
+                    f"invalid hook registry {config_file}: malformed condition for {event_name}",
+                    err=True,
+                )
+                raise typer.Exit(code=1)
+            if not isinstance(hook.get("command"), str) or not hook["command"].strip():
+                typer.echo(f"invalid hook registry {config_file}: {event_name} hook requires a command", err=True)
+                raise typer.Exit(code=1)
+            for flag in ("enabled", "optional"):
+                if flag in hook and not isinstance(hook[flag], bool):
+                    typer.echo(f"invalid hook registry {config_file}: {flag} must be a boolean", err=True)
+                    raise typer.Exit(code=1)
+    result = executor.check_hooks_for_event(event_name)
+    if json_output:
+        typer.echo(
+            json.dumps(
+                {
+                    "event": event_name,
+                    "has_hooks": result["has_hooks"],
+                    "hooks": [executor.execute_hook(hook) for hook in result["hooks"]],
+                }
+            )
+        )
+        return
+    if result["message"]:
+        typer.echo(result["message"])
+
+
+def register(app: typer.Typer) -> None:
+    app.add_typer(hook_app, name="hook")
